<script>
(function () {
  // All money in whole cents so the totals never drift
  var CASH = 1500, INST = 550, POST = 500;
  function money(c) { return '$' + (c / 100).toFixed(2); }
  function longDate(d) { return d.toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }); }
  function shortDate(d) { return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }); }

  var qtyEl = document.getElementById('qty');
  var methodEl = document.getElementById('method');
  var linesEl = document.getElementById('lines');
  var offerEl = document.getElementById('offer-text');
  var receipt = document.getElementById('receipt');
  var plan = 'full';

  function readQty() {
    var q = parseInt(qtyEl.value, 10);
    if (isNaN(q) || q < 1) q = 1;
    if (q > 5) q = 5;
    return q;
  }
  function addLine(text, value, cls) {
    var li = document.createElement('li');
    if (cls) li.className = cls;
    var s1 = document.createElement('span'); s1.textContent = text;
    var s2 = document.createElement('span'); s2.textContent = value;
    li.appendChild(s1); li.appendChild(s2); linesEl.appendChild(li);
  }
  function terms() {
    var q = readQty();
    var now = new Date();
    var delivery = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 7);
    var d1 = new Date(now.getFullYear(), now.getMonth() + 1, 1);
    var d2 = new Date(now.getFullYear(), now.getMonth() + 2, 1);
    var t = { q: q, delivery: delivery, d1: d1, d2: d2, method: methodEl.value };
    if (plan === 'full') {
      t.items = q * CASH; t.total = t.items + POST; t.today = t.total; t.later = 0;
    } else {
      t.items = q * INST * 3; t.total = t.items + POST; t.today = q * INST + POST; t.later = q * INST;
    }
    return t;
  }
  function offerSentence(t) {
    var copies = t.q === 1 ? '1 new copy' : t.q + ' new copies';
    var s = 'We sell you ' + copies + ' of The Money Handbook for ' + money(t.total) + ' AUD in total (' +
      t.q + ' × ' + money(plan === 'full' ? CASH : INST * 3) + ' plus ' + money(POST) + ' postage). ';
    if (plan === 'full') {
      s += 'You pay in full by ' + t.method + ' when you accept. ';
    } else {
      s += 'You pay in three instalments by ' + t.method + ': ' + money(t.today) + ' when you accept, then ' +
        money(t.later) + ' on ' + shortDate(t.d1) + ' and ' + money(t.later) + ' on ' + shortDate(t.d2) +
        '. The price is fixed and there are no late fees. ';
    }
    s += 'We post it within 2 business days of your first payment, and it reaches you no later than ' + longDate(t.delivery) + '.';
    return s;
  }
  function render() {
    var t = terms();
    linesEl.innerHTML = '';
    addLine(t.q + ' × The Money Handbook', money(t.items));
    addLine('Postage', money(POST));
    addLine('Total in AUD', money(t.total), 'total');
    if (plan === 'inst') {
      addLine('Due when you accept', money(t.today), 'sub');
      addLine('Due ' + shortDate(t.d1), money(t.later), 'sub');
      addLine('Due ' + shortDate(t.d2), money(t.later), 'sub');
    }
    addLine('Arrives no later than', longDate(t.delivery), 'sub');

    offerEl.innerHTML = '';
    var b = document.createElement('b'); b.textContent = 'Our offer, in full';
    var p = document.createElement('p'); p.textContent = offerSentence(t);
    offerEl.appendChild(b); offerEl.appendChild(p);
  }
  function changed() { receipt.hidden = true; render(); }

  document.getElementById('minus').addEventListener('click', function () { qtyEl.value = Math.max(1, readQty() - 1); changed(); });
  document.getElementById('plus').addEventListener('click', function () { qtyEl.value = Math.min(5, readQty() + 1); changed(); });
  qtyEl.addEventListener('input', changed);
  qtyEl.addEventListener('change', function () { qtyEl.value = readQty(); changed(); });
  methodEl.addEventListener('change', changed);
  Array.prototype.forEach.call(document.querySelectorAll('input[name="plan"]'), function (r) {
    r.addEventListener('change', function () { plan = r.value; changed(); });
  });

  document.getElementById('order').addEventListener('submit', function (e) {
    e.preventDefault();
    var t = terms();

    // Pick distinct copy numbers out of the 30 on the shelf
    var nums = [];
    while (nums.length < t.q) {
      var n = Math.floor(Math.random() * 30) + 1;
      if (nums.indexOf(n) === -1) nums.push(n);
    }
    nums.sort(function (a, b) { return a - b; });

    receipt.innerHTML = '';
    var s = document.createElement('strong');
    s.textContent = 'Offer accepted (practice only)';
    receipt.appendChild(s);
    var ul = document.createElement('ul');
    function item(text) { var li = document.createElement('li'); li.textContent = text; ul.appendChild(li); }
    item('You accepted: ' + offerSentence(t));
    item('Your ' + (t.q === 1 ? 'copy' : 'copies') + ': no. ' + nums.join(', ') + ' of 30, set aside and numbered for you.');
    item('Return option: 7 days from the day you receive it. Tell us before you send it back. It ends when the 7 days pass, when you use the copy, or when you tell us you are keeping it.');
    item('Defect or wrong description: full refund with no deduction. We consent to the return now.');
    item('No interest and no late fees. Until it is in your hands, any loss or damage is ours.');
    item('This is a practice site, so no order was placed and no money was taken.');
    receipt.appendChild(ul);
    receipt.hidden = false;
  });

  render();
})();
</script>

</body>
